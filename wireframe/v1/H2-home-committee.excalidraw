33065, "isDeleted": false, "boundElements": [], "updated": 1789543421572, "link": null, "locked": false, "index": "64"}, {"type": "text", "id": "ann3", "x": 290, "y": 930, "width": 420, "height": 18, "text": "คลิกการ์ด 'รอพิจารณา' → filter ลิสต์เฉพาะรายการที่รอ", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "baseline": 12, "lineHeight": 1.25, "strokeColor": "#adb5bd", "originalText": "คลิกการ์ด 'รอพิจารณา' → filter ลิสต์เฉพาะรายการที่รอ", "autoResize": true, "angle": 0, "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 465, "version": 2, "versionNonce": 110233066, "isDeleted": false, "boundElements": [], "updated": 1789543421572, "link": null, "locked": false, "index": "65"}], "appState": {"gridSize": 20, "gridStep": 5, "gridModeEnabled": false, "viewBackgroundColor": "#ffffff"}, "files": {}}